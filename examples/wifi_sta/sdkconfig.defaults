# Example defaults for QEMU Wi-Fi station test
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_QEMU=y

# Credentials — override via menuconfig or QEMU_SSID / QEMU_PASS env vars
CONFIG_ESP_WIFI_SSID="QEMU_TEST"
CONFIG_ESP_WIFI_PASSWORD="qemu1234"
CONFIG_ESP_MAXIMUM_RETRY=5

# WPA3/SAE mode required by app_main.c preprocessor guards
CONFIG_ESP_STATION_EXAMPLE_WPA3_SAE_PWE_HUNT_AND_PECK=y
