menu "Demo Wi-Fi Configuration"

    config DEMO_WIFI_SSID
        string "Wi-Fi SSID"
        default "QEMU_TEST"
        help
            Wi-Fi SSID used by the QEMU integration demo.
            Must match the mock_wpa_supplicant SSID (default: QEMU_TEST).

    config DEMO_WIFI_PASSWORD
        string "Wi-Fi Password"
        default "qemu1234"
        help
            Wi-Fi password for the QEMU integration demo.

endmenu

menu "lwIP Probe Configuration"

    config DEMO_LWIP_PROBE_ENABLE
        bool "Enable lwIP probe task (NEXT-004)"
        default y
        help
            Spawn a background TCP probe task after Wi-Fi connects.
            Used by QEMU integration tests to validate the full data-plane.

    config DEMO_LWIP_PROBE_HOST
        string "Probe target host (IP address)"
        default "10.0.2.100"
        depends on DEMO_LWIP_PROBE_ENABLE
        help
            IPv4 address of the TCP echo server launched by the test harness.

    config DEMO_LWIP_PROBE_PORT
        int "Probe target port"
        default 9988
        depends on DEMO_LWIP_PROBE_ENABLE
        help
            TCP port of the echo server (tools/echo_server.py).

endmenu
