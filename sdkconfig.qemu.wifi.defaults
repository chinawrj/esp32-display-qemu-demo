# sdkconfig.qemu.wifi.defaults
#
# QEMU virtual Wi-Fi sdkconfig overlay.
# Append this file to SDKCONFIG_DEFAULTS when building any ESP-IDF Wi-Fi
# sample against the QEMU Wi-Fi simulator.
#
# Usage (idf.py CLI — zero sample file changes):
#   idf.py \
#     -DEXTRA_COMPONENT_DIRS=/path/to/components \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;/path/to/sdkconfig.qemu.wifi.defaults" \
#     build
#
# Or include via tools/qemu-wifi-overlay.cmake (adds this file automatically).

# ── Primary switch ────────────────────────────────────────────────────────
# Enable the QEMU virtual Wi-Fi hardware component.
CONFIG_ESP_WIFI_QEMU=y

# ── QEMU Wi-Fi credentials ────────────────────────────────────────────────
# The mock wpa_supplicant answers any SSID/password combination, so these
# are just defaults; override them per-sample if needed.
# CONFIG_DEMO_* keys are used by our own wifi_ui.c demo component.
# CONFIG_ESP_WIFI_* keys are used by stock ESP-IDF station/scan samples.
CONFIG_DEMO_WIFI_SSID="QEMU_TEST"
CONFIG_DEMO_WIFI_PASSWORD="qemu1234"
CONFIG_ESP_WIFI_SSID="QEMU_TEST"
CONFIG_ESP_WIFI_PASSWORD="qemu1234"

# ── Disable hardware-only features that panic in QEMU ─────────────────────
# Watchdog resets interfere with QEMU's slower simulation speed.
CONFIG_ESP_TASK_WDT_EN=n
# QEMU does not emulate RNG entropy sources; use pseudo-random fallback.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# ── lwIP tuning for QEMU simulation speed ─────────────────────────────────
# Increase ARP timeout — QEMU + relay round-trips are slower than real HW.
CONFIG_LWIP_ARP_MAXAGE=30
# Lenient DHCP client timeout (we inject IP via mock_wpa so DHCP never
# replies, but dhcpc won't abort if it is disabled or times out gracefully).
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=0

# protocol_examples_common (tcp_client, udp_client, ...)
# Select Wi-Fi as connection type.
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_WIFI_SSID="QEMU_TEST"
CONFIG_EXAMPLE_WIFI_PASSWORD="qemu1234"
# Retry quickly in QEMU; mock_wpa answers immediately.
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=5

# TCP/UDP socket examples
# Use IPv4 string mode; target the QEMU relay gateway (maps to 127.0.0.1).
CONFIG_EXAMPLE_IPV4=y
CONFIG_EXAMPLE_SOCKET_IP_INPUT_STRING=y
CONFIG_EXAMPLE_IPV4_ADDR="10.0.2.2"
CONFIG_EXAMPLE_PORT=3333
