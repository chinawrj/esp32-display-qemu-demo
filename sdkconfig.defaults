# This file contains default configuration for esp32-display-qemu-demo

# Logging
CONFIG_LOG_DEFAULT_LEVEL=2

# FreeRTOS
CONFIG_FREERTOS_HZ=100

# ESP32 / clock
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_RTC_CLK_SRC_INT_RC=y

# Performance
CONFIG_OPTIMIZATION_LEVEL_RELEASE=y

# QEMU specific settings
CONFIG_SYSTEM_EVENT_QUEUE_SIZE=32

# --- LVGL configuration ---
# Color depth must match flush_cb expectations (16-bit RGB565 by default)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_INFO=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_OBSERVER=y

# Larger main task stack for LVGL
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL heap (benchmark needs more than default 64K)
CONFIG_LV_MEM_SIZE_KILOBYTES=128

# Enable benchmark demo + perf log mode (so summary is printed via LV_LOG)
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_PERF_MONITOR_LOG_MODE=y

# Fonts used by benchmark
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
